# 서버의 DEPLOY_PATH/.env에 복사하고 실제 값을 채우세요. 이 파일은 예시입니다.
DB_NAME=remake
DB_USERNAME=remake
DB_PASSWORD=

# 배정받은 호스트 포트를 입력한다. 비어 있으면 compose가 실행되지 않는다.
# 호스트 Nginx 사이트 파일의 proxy_pass 포트와 같아야 한다.
APP_PORT=

# JWT 서명 비밀키(32바이트 이상). 바꾸면 기존 로그인 쿠키가 모두 무효가 된다.
JWT_SECRET=

# 소셜 로그인 앱 키. 비어 있으면 해당 제공자 로그인은 OAUTH_FAILED다. 배포 담당자가 서버 .env에 채운다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API 키(AI 레시피·식단표 생성). 운영 전용 Google Cloud 프로젝트의 키로, Gemini API만 부를 수 있게 제한한다.
# 비어 있으면 생성 요청만 AI_UPSTREAM_ERROR로 실패한다. 배포 담당자가 서버 .env에 채운다.
GEMINI_API_KEY=
# 모델 코드. 비워 두면 앱 기본값(gemini-3.5-flash-lite, 무료 티어)을 쓴다.
GEMINI_MODEL=

# 영수증 사진 판독 전용 Gemini 키
OCR_GEMINI_API_KEY=
