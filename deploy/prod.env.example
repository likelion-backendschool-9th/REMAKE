# 서버의 DEPLOY_PATH/.env에 복사하고 실제 값을 채우세요. 이 파일은 예시입니다.
DB_NAME=remake
DB_USERNAME=remake
DB_PASSWORD=

# 배정받은 호스트 포트를 입력한다. 비어 있으면 compose가 실행되지 않는다.
# 호스트 Nginx 사이트 파일의 proxy_pass 포트와 같아야 한다.
APP_PORT=

# JWT 서명 비밀키(32바이트 이상). 바꾸면 기존 로그인 쿠키가 모두 무효가 된다.
JWT_SECRET=

# 소셜 로그인 앱 키. 비어 있으면 해당 제공자 로그인은 OAUTH_FAILED다. 배포 담당자가 서버 .env에 채운다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push 공개 키(백엔드에서 발급한 VAPID public key). 프론트 빌드 때 번들에 들어가는 공개 값이다.
# 개인 키는 여기에 넣지 않는다. 바꾸면 다음 프론트 배포 때 다시 빌드되어 적용된다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
