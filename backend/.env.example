# 이 파일을 복사해서 같은 폴더에 .env 파일을 만들고 값을 채우세요.
# .env는 git에 올라가지 않습니다. (비밀번호·API 키는 절대 커밋하지 않기)
# docker-compose.yml과 Spring(application-local.yml)이 모두 이 값을 사용합니다.

# ===== Local PostgreSQL =====
# 내 PC에서 5432 포트를 이미 다른 PostgreSQL이 쓰고 있으면 5433 등으로 변경
DB_PORT=5432
DB_NAME=remake
DB_USERNAME=remake
DB_PASSWORD=
