# 이 파일을 복사해서 같은 폴더에 .env.local 파일을 만들고 값을 채우세요.
# .env.local은 git에 올라가지 않습니다.
# NEXT_PUBLIC_ 으로 시작하는 값은 브라우저에 노출되므로 비밀 값은 넣지 않기

# Spring 백엔드 주소
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# true면 MSW 더미 응답 사용 (백엔드 없이 화면 개발)
NEXT_PUBLIC_API_MOCKING=true

# Web Push 공개 키 (백엔드에서 발급한 VAPID public key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
